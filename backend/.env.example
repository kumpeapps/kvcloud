# Application
APP_NAME=KVCloud
DEBUG=True
SECRET_KEY=your-secret-key-here-change-in-production

# Database Configuration (DB Agnostic)
# For PostgreSQL:
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/kvcloud
# For MySQL:
# DATABASE_URL=mysql+aiomysql://user:password@localhost:3306/kvcloud
# For SQLite:
DATABASE_URL=sqlite+aiosqlite:///./kvcloud.db

# JWT Configuration
JWT_SECRET_KEY=your-jwt-secret-key-here
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS
CORS_ORIGINS=http://localhost:4200,http://localhost:3000

# Proxmox Configuration (example)
# PROXMOX_HOST=proxmox.example.com
# PROXMOX_USER=root@pam
# PROXMOX_PASSWORD=password
